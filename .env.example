# Server
PORT=3000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gestion_proyectos
DB_USER=root
DB_PASSWORD=password
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0

# JWT
JWT_SECRET=dev_secret_key
JWT_EXPIRES_IN=24h

# Uploads
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.jpg,.jpeg,.png,.gif,.zip,.rar

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_MAX_REQUESTS=5
AUTH_RATE_LIMIT_WINDOW_MS=900000
USER_RATE_LIMIT_MAX_REQUESTS=100
USER_RATE_LIMIT_WINDOW_MS=900000

# Logs
LOG_LEVEL=debug
LOG_ERROR_FILE=logs/error.log
LOG_COMBINED_FILE=logs/combined.log

# File Validation
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/plain,text/csv,application/zip,application/x-rar-compressed

# Request Timeout
REQUEST_TIMEOUT=10000

# Database Setup
SETUP_DB=false

# Database Cleaning (Deploy Control)
# Set to 'true' to clean database on deploy, 'false' to skip (default: false)
# WARNING: This will DELETE ALL DATA from the database!
# Usage in Render:
#   1. Set CLEAN_DATABASE=true before deploy to clean
#   2. After deploy, change to CLEAN_DATABASE=false to prevent future cleanings
CLEAN_DATABASE=false

# Security
BCRYPT_SALT_ROUNDS=12
REFRESH_TOKEN_EXPIRY_DAYS=30
JWT_BLACKLIST_FALLBACK_HOURS=24
DEFAULT_PAGINATION_LIMIT=10
AUDIT_PAGINATION_LIMIT=50
